cabal-version:      2.4
name:               sleep-tumblr
version:            0.1.0
license-file:       LICENSE
copyright:          Copyright (C) 2023 Antoine Leblanc
maintainer:         nicuveo@gmail.com
author:             Antoine Leblanc
homepage:           https://github.com/nicuveo/sleep
bug-reports:        https://github.com/nicuveo/sleep/issues
synopsis:           Tumblr REST client
category:           Web
extra-source-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/nicuveo/sleep.git

library
  exposed-modules:
    Web.Sleep.Tumblr
    Web.Sleep.Tumblr.Auth
    Web.Sleep.Tumblr.Commands
    Web.Sleep.Tumblr.Data
    Web.Sleep.Tumblr.Monad
    Web.Sleep.Tumblr.Request
    Web.Sleep.Tumblr.Response
    Web.Sleep.Tumblr.Simple

  hs-source-dirs:     src
  default-language:   GHC2021
  default-extensions:
    AllowAmbiguousTypes
    ApplicativeDo
    BlockArguments
    DataKinds
    DefaultSignatures
    DerivingVia
    DuplicateRecordFields
    FunctionalDependencies
    GADTs
    LambdaCase
    MultiWayIf
    NoImplicitPrelude
    OverloadedStrings
    PackageImports
    RecordWildCards
    RoleAnnotations
    StrictData
    TypeFamilies
    ViewPatterns

  ghc-options:
    -Wall -Werror -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
    -Wtabs -Wno-unused-do-bind -fhide-source-paths
    -foptimal-applicative-do -funbox-small-strict-fields

  build-depends:
    , base                >=4.16 && <5
    , aeson
    , authenticate-oauth
    , bytestring
    , http-api-data
    , http-client
    , http-types
    , lens
    , network-uri
    , sleep-core
    , text
    , time
    , vector

--    , http-api-data
--    , lens
--    , network-uri
--    , time
-- authenticate-oauth,
-- containers,
-- data-has,
-- http-client-tls,
-- http-conduit,
-- http-types,
-- mtl,
-- resourcet,
-- safe-exceptions,
-- transformers,
-- transformers-base,
-- uri-encode,
-- vector,
